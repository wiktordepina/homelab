      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "A",
          "expr": "node_systemd_unit_state{job=\"workstation\"} == 1",
          "format": "table",
          "instant": true
        }
