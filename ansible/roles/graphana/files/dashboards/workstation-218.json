        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "A",
          "expr": "increase(node_vmstat_oom_kill{job=\"workstation\"}[24h])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
