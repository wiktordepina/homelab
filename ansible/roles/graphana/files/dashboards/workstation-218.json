      }
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Rootfs used",
      "datasource": {
        "type": "prometheus",
        "uid": "bewhi3wyusoaoc"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "A",
          "expr": "1 - node_filesystem_avail_bytes{job=\"workstation\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"workstation\",mountpoint=\"/\"}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.8
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "description": "Holds the agent's checkouts under ~/work."
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU by mode",
      "datasource": {
        "type": "prometheus",
        "uid": "bewhi3wyusoaoc"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "A",
          "expr": "sum by (mode) (rate(node_cpu_seconds_total{job=\"workstation\",mode!=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30,
            "lineWidth": 1
          },
          "min": 0,
          "max": 4
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Cores in use, out of 4. claude.slice units are capped at 2 cores each (CPUQuota=200%). Steal is time the host gave to other guests."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory",
      "datasource": {
        "type": "prometheus",
        "uid": "bewhi3wyusoaoc"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{job=\"workstation\"} - node_memory_MemAvailable_bytes{job=\"workstation\"}",
          "legendFormat": "used"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes{job=\"workstation\"}",
          "legendFormat": "available"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "C",
          "expr": "node_memory_SwapTotal_bytes{job=\"workstation\"} - node_memory_SwapFree_bytes{job=\"workstation\"}",
          "legendFormat": "swap used"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Used is total minus MemAvailable, so page cache the kernel can reclaim does not count. claude.slice is capped at 6 GiB."
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pressure (PSI)",
      "datasource": {
        "type": "prometheus",
        "uid": "bewhi3wyusoaoc"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "A",
          "expr": "rate(node_pressure_cpu_waiting_seconds_total{job=\"workstation\"}[$__rate_interval])",
          "legendFormat": "cpu some"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "B",
          "expr": "rate(node_pressure_memory_waiting_seconds_total{job=\"workstation\"}[$__rate_interval])",
          "legendFormat": "memory some"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "C",
          "expr": "rate(node_pressure_memory_stalled_seconds_total{job=\"workstation\"}[$__rate_interval])",
          "legendFormat": "memory full"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "D",
          "expr": "rate(node_pressure_io_waiting_seconds_total{job=\"workstation\"}[$__rate_interval])",
          "legendFormat": "io some"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "bewhi3wyusoaoc"
          },
          "refId": "E",
          "expr": "rate(node_pressure_io_stalled_seconds_total{job=\"workstation\"}[$__rate_interval])",
          "legendFormat": "io full"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Share of wall-clock time tasks were stalled on each resource. 'some': at least one task waited; 'full': every non-idle task did. Sustained memory pressure means the VM is too small for the load."
    },
    {
      "id": 11,
