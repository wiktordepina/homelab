{{ ansible_managed | comment }}
# Every credential Hermes holds is read from this file. Values come from
# /pve/secrets/hermes.sh on the apply runner; an unset one lands here empty,
# which disables the corresponding integration rather than failing the run.
{% for key, value in hermes_env | dictsort %}
{{ key }}={{ value }}
{% endfor %}
{% for key, value in hermes_secrets | dictsort %}
{{ key }}={{ value }}
{% endfor %}
