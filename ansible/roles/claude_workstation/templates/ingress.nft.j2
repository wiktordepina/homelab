#!/usr/sbin/nft -f
# {{ ansible_managed }}
#
# Inbound only; outbound is egress_proxy's table. A table of its own, so a
# reload replaces just this one.

table inet ingress
delete table inet ingress

{% set verdict = 'drop' if claude_workstation_egress_enforce else 'accept' %}
table inet ingress {
    # What was refused (or, in observation mode, would have been), by source.
    set observed_input {
        type ipv4_addr . inet_proto . inet_service
        flags dynamic,timeout
        timeout 7d
        size 4096
    }

    chain input {
        type filter hook input priority filter; policy accept;

        iifname "lo" accept
        ct state established,related accept
        ct state invalid drop
        meta l4proto { icmp, ipv6-icmp } accept
{% for src in claude_workstation_ssh_sources %}
        # {{ src.comment }}
        ip saddr {{ src.addr }} tcp dport 22 accept
{% endfor %}
        # maitre-d's MCP server and web UI, through the reverse proxy only
{% for src in claude_workstation_service_sources %}
        ip saddr {{ src }} tcp dport {{ claude_workstation_service_port }} accept
{% endfor %}
        update @observed_input { ip saddr . meta l4proto . th dport }
        counter {{ verdict }}
    }

    # The agent may not reach the control service on this host. Its traffic to
    # the host's own address leaves through lo, which the egress table accepts;
    # a reject in any table is final, so this holds whatever that table says.
    chain output {
        type filter hook output priority filter; policy accept;

        fib daddr type local meta skuid {{ claude_workstation_agent_uid }} tcp dport {{ claude_workstation_service_port }} counter reject with tcp reset
    }
}
