#!/bin/sh
# Runs one workflow for claude-job@.service: maitre-d's run input arrives on
# stdin, the runner's outcome leaves on stdout. CLAUDE_JOB_PROJECT comes from
# the job's environment file and names a checkout under the work directory.
set -eu

case "${CLAUDE_JOB_PROJECT:-}" in
  "" | */* | .*)
    echo "claude-job: CLAUDE_JOB_PROJECT must name a checkout under {{ claude_workstation_work_dir }}" >&2
    exit 64
    ;;
esac

cd "{{ claude_workstation_work_dir }}/${CLAUDE_JOB_PROJECT}"
# Each stage runs the CLI bundled with the runner's SDK, in auto mode, and the
# runner waits on each query itself. The CLI inherits this environment, so the
# idle ceiling stays off in case a stage's background work is still subject to
# it: RuntimeMaxSec and the runner's stage timeout end a job instead.
CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 exec "{{ claude_workstation_job_runner_dir }}/venv/bin/maitre-d-runner"
