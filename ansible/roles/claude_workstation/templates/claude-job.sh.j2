#!/bin/sh
# Runs one headless job for claude-job@.service: the prompt arrives on stdin,
# the JSON result leaves on stdout. CLAUDE_JOB_PROJECT comes from the job's
# environment file and names a checkout under the work directory.
set -eu

case "${CLAUDE_JOB_PROJECT:-}" in
  "" | */* | .*)
    echo "claude-job: CLAUDE_JOB_PROJECT must name a checkout under {{ claude_workstation_work_dir }}" >&2
    exit 64
    ;;
esac

cd "{{ claude_workstation_work_dir }}/${CLAUDE_JOB_PROJECT}"
# Explicit, because an interactive session on this account defaults to auto
# mode. A job is unattended, so whatever is off the managed allow list must be
# denied and reported, not judged by the classifier.
exec claude -p --permission-mode default --output-format json
