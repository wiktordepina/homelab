#!/bin/sh
# Runs one headless job for claude-job@.service: the prompt arrives on stdin,
# the JSON result leaves on stdout. CLAUDE_JOB_PROJECT comes from the job's
# environment file and names a checkout under the work directory.
set -eu

case "${CLAUDE_JOB_PROJECT:-}" in
  "" | */* | .*)
    echo "claude-job: CLAUDE_JOB_PROJECT must name a checkout under {{ claude_workstation_work_dir }}" >&2
    exit 64
    ;;
esac

cd "{{ claude_workstation_work_dir }}/${CLAUDE_JOB_PROJECT}"
# Auto mode, as interactive sessions: the egress fence is the boundary, and in
# -p a refusal ends in a denial, never a hang. A job's prompt starts a workflow,
# and -p stops waiting for one after an idle ceiling (10 min by default) yet
# still reports success, so the ceiling is off: RuntimeMaxSec and maitre-d's
# own per-workflow limit end a job instead.
CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0 exec claude -p --permission-mode auto --output-format json
