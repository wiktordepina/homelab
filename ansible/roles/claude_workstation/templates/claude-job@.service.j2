[Unit]
Description=Claude Code workflow job %i
Wants=network-online.target
After=network-online.target squid.service egress-firewall.service

# The job directory is maitre-d's alone. systemd reads the environment file and
# opens the run input and the result as root before dropping to the agent, so
# the agent can neither change its own input nor rewrite its result afterwards.
[Service]
Type=exec
EnvironmentFile={{ claude_workstation_jobs_dir }}/%i/job.env
StandardInput=file:{{ claude_workstation_jobs_dir }}/%i/input.json
StandardOutput=truncate:{{ claude_workstation_jobs_dir }}/%i/result.json
StandardError=journal
ExecStart=/usr/local/libexec/claude-job
# mait-code's recursion guard, which makes its observe hooks skip. Each workflow
# stage is a session of its own, so the hooks would extract from fragments of a
# run. Until maitre-d's runner extracts once over the whole run, jobs produce
# no memories.
Environment=MAIT_CODE_NESTED=1
RuntimeMaxSec={{ claude_workstation_job_runtime_max }}
MemoryMax={{ claude_workstation_unit_memory_max }}
CPUQuota={{ claude_workstation_job_cpu_quota }}
{% include 'unit-hardening.j2' %}
