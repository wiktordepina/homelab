---
# Generated from config/services.yaml by the containers role. Do not edit on
# the host: the next Ansible run overwrites it.
{%- for category in catalogue.categories %}
{%- set groups = [] %}
{%- for subcategory in category.subcategories %}
{%- set entries = [] %}
{%- for service in catalogue.services %}
{%- if service.category == category.name
       and service.subcategory == subcategory.name
       and service.listed | default(true) %}
{%- set _ = entries.append(service) %}
{%- endif %}
{%- endfor %}
{%- if entries %}
{%- set _ = groups.append({'title': subcategory.title, 'services': entries}) %}
{%- endif %}
{%- endfor %}
{%- if groups %}
- {{ category.title }}:
{%- for group in groups %}
    - {{ group.title }}:
{%- for service in group.services %}
        - {{ service.title | default(service.name) }}:
            href: https://{{ service.name }}.homelab.matagoth.com/
            description: {{ service.description }}
            icon: {{ service.icon }}
            siteMonitor: https://{{ service.name }}.homelab.matagoth.com/
{%- endfor %}
{%- endfor %}
{%- endif %}
{%- endfor %}
