#!/bin/bash
#
# lint - Run the repo linters in the runner-toolbox container.
#
# Description:
#   Mounts only the working tree (no /pve/secrets, no /pve/terraform, no SSH
#   keys) and runs the bundled `lint` script. Safe to run on any machine with
#   Docker and the locally-built runner-toolbox image.
#
#   The image is rebuilt from the working tree on every run. It is cached, so
#   this costs seconds unless runner-toolbox/ changed, and a stale image would
#   lint with stale scripts. CI builds it beforehand with its own layer cache
#   and sets LINT_IMAGE_PREBUILT to skip this.
#
# Usage:
#   ./run/lint

set -euo pipefail

if [[ -z "${LINT_IMAGE_PREBUILT:-}" ]]; then
  docker build -q runner-toolbox -t runner-toolbox:latest > /dev/null
fi

docker run --rm \
  --name runner-lint \
  -v "$(pwd):/build" \
  -w /build \
  runner-toolbox:latest \
  lint
